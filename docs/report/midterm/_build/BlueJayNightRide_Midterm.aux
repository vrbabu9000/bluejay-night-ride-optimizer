\newlabel{fig:assumed}{{6}{7}{Three assumed input distributions \ASM . Left: party-size shares per request. Middle: placeholder patience, shown as the share of riders still willing to wait after a given time. Right: Lyft delay from the Lyft order to its arrival at the curb (lognormal); dashed lines mark its median (8 min) and 90th percentile (about 15 min). None is a measured Hopkins distribution}{figure.caption.11}{}}
\newlabel{fig:assumed@cref}{{[figure][6][]6}{[1][5][]7}{}{}{}}
\newlabel{fig:noshow}{{7}{7}{Two denominators for the same 2,359 no-shows. Top: April's share of all recorded requests (4.7\%) \OBS . Bottom: the rate per van arrival (8.9\%), which holds only under the stated status mapping \DER . Applying 4.7\% at the curb would use the wrong denominator}{figure.caption.12}{}}
\newlabel{fig:noshow@cref}{{[figure][7][]7}{[1][6][]7}{}{}{}}
