  <diagram id="p2" name="Players (dispatchers)">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="434" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p2-root" />
        <mxCell id="p2-layer" parent="p2-root" />
        <mxCell id="p2-h-col1" value="Decides on each request" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#444441;" vertex="1" parent="p2-layer">
          <mxGeometry x="210" y="38" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2-h-col2" value="Decides every W seconds" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#444441;" vertex="1" parent="p2-layer">
          <mxGeometry x="494" y="38" width="260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2-h-row1" value="Greedy, one at a time" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#444441;" vertex="1" parent="p2-layer">
          <mxGeometry x="20" y="76" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-h-row2" value="Joint MILP, all pending" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#444441;" vertex="1" parent="p2-layer">
          <mxGeometry x="20" y="176" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-h-row3" value="Benchmarks" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#444441;" vertex="1" parent="p2-layer">
          <mxGeometry x="20" y="318" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-A" value="&lt;b&gt;A: immediate greedy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Inserts each request&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2-layer">
          <mxGeometry x="210" y="76" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-B" value="&lt;b&gt;B: batched greedy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A, but waits W seconds&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2-layer">
          <mxGeometry x="494" y="76" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-notplanned" value="&lt;b&gt;Not planned&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Little to coordinate&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5F5E5A;fontColor=#444441;strokeWidth=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="p2-layer">
          <mxGeometry x="210" y="176" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-C" value="&lt;b&gt;C: batched MILP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;B, but decides jointly&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2-layer">
          <mxGeometry x="494" y="176" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-separator" value="" style="shape=line;strokeWidth=1;dashed=1;dashPattern=6 4;strokeColor=#5F5E5A;fillColor=none;html=1;" vertex="1" parent="p2-layer">
          <mxGeometry x="30" y="280" width="724" height="10" as="geometry" />
        </mxCell>
        <mxCell id="p2-N" value="&lt;b&gt;N: floor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nearest van, no pooling&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2-layer">
          <mxGeometry x="210" y="318" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-H" value="&lt;b&gt;H: ceiling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Decides once, sees all&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p2-layer">
          <mxGeometry x="494" y="318" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p2-gaps" value="&lt;b&gt;Gaps between players&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;b&gt;A − N&lt;/b&gt; = pooling&lt;br&gt;&lt;b&gt;B − A&lt;/b&gt; = waiting&lt;br&gt;&lt;b&gt;C − B&lt;/b&gt; = coordination&lt;br&gt;&lt;b&gt;H − C&lt;/b&gt; = headroom&lt;/font&gt;" style="rounded=1;arcSize=6.35;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;strokeWidth=1;fontSize=13;align=left;verticalAlign=top;spacingTop=14;spacingLeft=14;spacingRight=8;" vertex="1" parent="p2-layer">
          <mxGeometry x="790" y="76" width="184" height="126" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="Engine loop (one turn)">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="880" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="p3-root" />
        <mxCell id="p3-layer" parent="p3-root" />
        <mxCell id="p3-pop" value="&lt;b&gt;Pop next event from the queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tie order: drop-offs, pickups, new requests,&lt;br&gt;patience checks, dispatch ticks&lt;/font&gt;" style="rounded=1;arcSize=10.53;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="155" y="30" width="290" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p3-update" value="&lt;b&gt;Update world state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Van positions, loads, request states&lt;/font&gt;" style="rounded=1;arcSize=14.29;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="155" y="146" width="290" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p3-trigger" value="&lt;b&gt;Trigger fired?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="190" y="242" width="220" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p3-observe" value="&lt;b&gt;Build observation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Current state + revealed requests only&lt;br&gt;(no future information)&lt;/font&gt;" style="rounded=1;arcSize=11.76;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="155" y="374" width="290" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p3-decide" value="&lt;b&gt;Dispatcher.decide()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Observation in, commands out&lt;/font&gt;" style="rounded=1;arcSize=14.29;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="155" y="478" width="290" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p3-validate" value="&lt;b&gt;Referee validates commands&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Capacity, pickup before drop-off, same van,&lt;br&gt;wait/ride limits, frozen commitments,&lt;br&gt;shift end&lt;/font&gt;" style="rounded=1;arcSize=9.09;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="155" y="570" width="290" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p3-commit" value="&lt;b&gt;Commit + schedule arrivals&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Van arrival events go into the queue&lt;/font&gt;" style="rounded=1;arcSize=13.33;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="155" y="698" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3-reject" value="&lt;b&gt;Log reason&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Rejected, state unchanged&lt;/font&gt;" style="rounded=1;arcSize=14.29;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="565" y="586" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p3-append" value="&lt;b&gt;Append to replay log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Every event, time-stamped&lt;/font&gt;" style="rounded=1;arcSize=15.38;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="70" y="798" width="860" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p3-cancel" value="&lt;b&gt;Cancel request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Patience clock ran out&lt;/font&gt;" style="rounded=1;arcSize=11.76;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="545" y="140" width="160" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p3-overflow" value="&lt;b&gt;Overflow (Lyft) rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Counts as Lyft overflow&lt;br&gt;or abandoned&lt;/font&gt;" style="rounded=1;arcSize=11.76;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="745" y="140" width="170" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p3-end" value="&lt;b&gt;Accounting check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;generated = completed + abandoned +&lt;br&gt;overflow + unserved at close&lt;/font&gt;" style="rounded=1;arcSize=11.76;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="p3-layer">
          <mxGeometry x="690" y="34" width="270" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p3-triggers" value="&lt;b&gt;Triggers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;New request (on-request players)&lt;br&gt;Tick every W (batched players)&lt;br&gt;Urgent request (any player)&lt;/font&gt;" style="rounded=1;arcSize=9.52;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;strokeWidth=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;" vertex="1" parent="p3-layer">
